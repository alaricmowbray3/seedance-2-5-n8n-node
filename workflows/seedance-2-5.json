      "typeVersion": 4.5,
      "position": [
        650,
        140
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $json.base_url + '/videos/generations' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "User-Agent",
              "value": "seedance-2-5-n8n-node/1.0"
            }
          ]
        },
        "options": {
          "timeout": 120000,
          "response": {
