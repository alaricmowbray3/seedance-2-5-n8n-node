          "name": "Video API bearer"
        }
      }
    },
    {
      "id": "585a55fd-2072-45da-a264-de9362bd1918",
      "name": "Remember job",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        870,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const config = $('Configure').first().json;\nconst response = $input.first().json;\nconst request_id = config.resume_request_id || response.request_id;\nif (typeof request_id !== 'string' || !/^[A-Za-z0-9_-]+$/.test(request_id)) {\n  throw new Error('Missing or malformed request_id; inspect submit result before sending another POST');\n}\nreturn [{json: {base_url: config.base_url, request_id, polls: 0,\n  deadline_ms: Date.now() + config.timeout_seconds * 1000,\n  max_polls: config.max_polls, poll_seconds: config.poll_seconds, wait_seconds: config.poll_seconds}}];"
      }
    },
    {
      "id": "fca106f8-0109-4a91-b62d-ba43c8cbd8f9",
      "name": "Wait before poll",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        1100,
        0
      ],
      "parameters": {
