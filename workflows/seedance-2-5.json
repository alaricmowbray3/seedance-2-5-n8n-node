        "amount": "={{ $json.wait_seconds }}",
        "unit": "seconds"
      },
      "webhookId": "b2e650cb-e603-4aba-b468-d833682dff27"
    },
    {
      "id": "6bf4d5fc-e854-442a-83fa-61ce8bb4d063",
      "name": "Poll status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        1320,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $json.base_url + '/videos/' + encodeURIComponent($json.request_id) }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
