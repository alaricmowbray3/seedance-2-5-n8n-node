        }
      }
    },
    {
      "id": "d80a15ca-b634-4e0c-add3-743566017192",
      "name": "Inspect response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const prior = $('Wait before poll').item.json;\nconst response = $input.first().json;\nconst next = {...prior, polls: prior.polls + 1};\nconst body = response.body || {};\nconst code = Number(response.statusCode);\nif (code >= 200 && code < 300 && ['done', 'failed', 'expired'].includes(body.status)) {\n  return [{json: {...next, status: body.status, error: body.error || null, usage: body.usage || null}}];\n}\nif (Date.now() >= prior.deadline_ms || next.polls >= prior.max_polls) {\n  throw new Error(`Polling stopped for ${prior.request_id}; resume this ID, do not submit again`);\n}\nif (code === 429 || code === 503) {\n  const headers = response.headers || {};\n  const hint = headers['retry-after'] ?? headers['Retry-After'];\n  let seconds = Number(hint);\n  if (!Number.isFinite(seconds) && hint) seconds = (Date.parse(hint) - Date.now()) / 1000;\n  if (!Number.isFinite(seconds) || seconds < 0) seconds = prior.poll_seconds;\n  next.wait_seconds = Math.max(1, Math.ceil(seconds));\n  if (Date.now() + next.wait_seconds * 1000 >= prior.deadline_ms) {\n    throw new Error(`Retry-After exceeds deadline for ${prior.request_id}; resume later`);\n  }\n  return [{json: {...next, status: 'pending', retry_http_status: code}}];\n}\nif (!(code >= 200 && code < 300)) throw new Error(`Poll HTTP ${code} for ${prior.request_id}; inspect execution data`);\nif (body.status !== 'pending') throw new Error(`Unknown job status ${String(body.status)} for ${prior.request_id}`);\nreturn [{json: {...next, status: 'pending', wait_seconds: prior.poll_seconds}}];"
      }
    },
