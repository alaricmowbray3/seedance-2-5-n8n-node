      "typeVersion": 2,
      "position": [
        200,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// One video per execution. Set resume_request_id to poll an existing job.\nconst config = {\n  base_url: 'https://argolink.io/v1', resume_request_id: '',\n  poll_seconds: 10, timeout_seconds: 3600, max_polls: 240,\n  request: {model: 'seedance-2.5', prompt: 'A paper boat drifts across a rain puddle at dawn; low tracking camera, gentle ripples and natural water sound.', duration: 5, resolution: '720p', aspect_ratio: '16:9', generate_audio: true}\n};\nreturn [{json: config}];"
      }
    },
    {
      "id": "c6a12ee8-1b9b-4384-b4a6-7c6640e14ad2",
      "name": "Resume existing?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        420,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "1dd32aca-4824-4cee-8f53-8c7f0830de89",
              "leftValue": "={{ $json.resume_request_id }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
